## Expo public env vars (safe to commit; values are public identifiers)
#
# Default API base URL. Should include `/api`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3003/api

# Optional: name to display (local|staging|prod)
EXPO_PUBLIC_ENV_NAME=staging

# Firebase web config (public identifiers; NOT service-account keys)
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

